module ParserParityParserCombinator export (ParserState(..), ParserValue(..), ParserStep(..), ParserExpectation(..), Parser(..), ParserEnd(..), runParser, parserPure, parserFail, parserFailExpected, parserFailExpectedAtCurrent, parserBind, parserMap, parserChoice, parserReturnAtEndOr, parserCurrentTokenStartOr, captureSpan, diagnosticLabel, labelExpected, expectToken, expectIdentifierToken, expectTokenPrefix, parserStateAtEnd) {
  import Prelude exposing (Option(..), stringIndexOf);
  import ParserParityDiagnostic exposing (ParserDiagnostic(..));
  import ParserParitySource exposing (ParserSourceInput(..), ParserSourceSymbol(..), basicUnexpectedSpan);
  import ParserParityToken exposing (TokenKind(..), TokenMatch(..), tokenMatches, tokenSpan, tokenStart, tokenText);

  def parserFunctorAudit : String = "class Functor";
  def parserApplicativeAudit : String = "class Applicative";
  def parserMonadAudit : String = "class Monad";

  data ParserState =
      ParserState : ParserSourceInput -> ParserState;

  data ParserValue =
      ValueUnit : ParserValue
    | ValueToken : ParserSourceSymbol -> ParserValue
    | ValueProjectionRows : String -> ParserValue
    | ValueConstructorRows : String -> ParserValue
    | ValueModuleKey : String -> ParserValue;

  data ParserStep =
      ParserStepOk : ParserState -> ParserValue -> ParserStep
    | ParserStepError : ParserDiagnostic -> ParserStep;

  data ParserExpectation =
      ParserExpectEquals : ParserExpectation
    | ParserExpectImportSemicolon : ParserExpectation
    | ParserExpectImportAlias : ParserExpectation
    | ParserExpectImportExposingSeparator : ParserExpectation
    | ParserExpectDefSemicolon : ParserExpectation
    | ParserExpectLetIn : ParserExpectation
    | ParserExpectLetAnnotationType : ParserExpectation
    | ParserExpectConstructorColon : ParserExpectation
    | ParserExpectCaseBranchArrow : ParserExpectation
    | ParserExpectInstanceMethodEquals : ParserExpectation
    | ParserExpectFunctionalDependencyArrow : ParserExpectation
    | ParserExpectTypeFamilyEquationEquals : ParserExpectation
    | ParserExpectConstructorForallDot : ParserExpectation
    | ParserExpectExpressionCloseParen : ParserExpectation;

  data Parser a =
      Parser : (ParserState -> ParserStep) -> Parser a;

  data ParserEnd =
      ParserAtEnd : ParserEnd
    | ParserNotAtEnd : ParserEnd
    | ParserEndUnknown : ParserEnd;

  def runParser : ∀ a. Parser a -> ParserState -> ParserStep =
    λ(parser : Parser a) λ(state : ParserState) case parser of {
      Parser run -> run state
    };

  def parserPure : ParserValue -> Parser ParserValue =
    λ(value : ParserValue)
      (Parser (λ(state : ParserState) ParserStepOk state value) : Parser ParserValue);

  def parserFail : ParserDiagnostic -> Parser ParserValue =
    λ(diagnostic : ParserDiagnostic)
      (Parser (λ(state : ParserState) ParserStepError diagnostic) : Parser ParserValue);

  def currentTokenSpanOr : String -> ParserState -> String =
    λ(fallbackSpan : String) λ(state : ParserState) case state of {
      ParserState stream -> case stream of {
        SourceInputNil -> fallbackSpan;
        SourceInputCons token _ -> tokenSpan token
      }
    };

  def parserDiagnosticForExpectation : ParserExpectation -> String -> ParserDiagnostic =
    λ(expectation : ParserExpectation) λ(span : String) case expectation of {
      ParserExpectEquals -> ExpectedEquals span;
      ParserExpectImportSemicolon -> ExpectedImportSemicolon span;
      ParserExpectImportAlias -> ExpectedImportAlias span;
      ParserExpectImportExposingSeparator -> ExpectedImportExposingSeparator span;
      ParserExpectDefSemicolon -> ExpectedDefSemicolon span;
      ParserExpectLetIn -> ExpectedLetIn span;
      ParserExpectLetAnnotationType -> ExpectedLetAnnotationType span;
      ParserExpectConstructorColon -> ExpectedConstructorColon span;
      ParserExpectCaseBranchArrow -> ExpectedCaseBranchArrow span;
      ParserExpectInstanceMethodEquals -> ExpectedInstanceMethodEquals span;
      ParserExpectFunctionalDependencyArrow -> ExpectedFunctionalDependencyArrow span;
      ParserExpectTypeFamilyEquationEquals -> ExpectedTypeFamilyEquationEquals span;
      ParserExpectConstructorForallDot -> ExpectedConstructorForallDot span;
      ParserExpectExpressionCloseParen -> ExpectedExpressionCloseParen span
    };

  def parserFailExpected : ParserExpectation -> String -> Parser ParserValue =
    λ(expectation : ParserExpectation) λ(span : String)
      parserFail (parserDiagnosticForExpectation expectation span);

  def parserFailExpectedAtCurrent : ParserExpectation -> Parser ParserValue =
    λ(expectation : ParserExpectation)
      (Parser
        (λ(state : ParserState)
          ParserStepError (parserDiagnosticForExpectation expectation (currentTokenSpanOr basicUnexpectedSpan state))) : Parser ParserValue);

  def parserBind : Parser ParserValue -> (ParserValue -> Parser ParserValue) -> Parser ParserValue =
    λ(parser : Parser ParserValue) λ(next : ParserValue -> Parser ParserValue)
      (Parser
        (λ(state : ParserState) case runParser parser state of {
          ParserStepOk nextState value -> runParser (next value) nextState;
          ParserStepError diagnostic -> ParserStepError diagnostic
        }) : Parser ParserValue);

  def parserMap : (ParserValue -> ParserValue) -> Parser ParserValue -> Parser ParserValue =
    λ(mapper : ParserValue -> ParserValue) λ(parser : Parser ParserValue)
      parserBind parser (λ(value : ParserValue) parserPure (mapper value));

  def parserChoice : Parser ParserValue -> Parser ParserValue -> Parser ParserValue =
    λ(first : Parser ParserValue) λ(second : Parser ParserValue)
      (Parser
        (λ(state : ParserState) case runParser first state of {
          ParserStepOk nextState value -> ParserStepOk nextState value;
          ParserStepError diagnostic -> case diagnostic of {
            UnexpectedSourceText _ -> runParser second state;
            ExpectedCompleteModule _ -> runParser second state;
            ExpectedEquals span -> ParserStepError (ExpectedEquals span);
            ExpectedImportSemicolon span -> ParserStepError (ExpectedImportSemicolon span);
            ExpectedImportAlias span -> ParserStepError (ExpectedImportAlias span);
            ExpectedImportExposingSeparator span -> ParserStepError (ExpectedImportExposingSeparator span);
            ExpectedDefSemicolon span -> ParserStepError (ExpectedDefSemicolon span);
            ExpectedLetIn span -> ParserStepError (ExpectedLetIn span);
            ExpectedLetAnnotationType span -> ParserStepError (ExpectedLetAnnotationType span);
            ExpectedConstructorColon span -> ParserStepError (ExpectedConstructorColon span);
            ExpectedCaseBranchArrow span -> ParserStepError (ExpectedCaseBranchArrow span);
            ExpectedInstanceMethodEquals span -> ParserStepError (ExpectedInstanceMethodEquals span);
            ExpectedFunctionalDependencyArrow span -> ParserStepError (ExpectedFunctionalDependencyArrow span);
            ExpectedTypeFamilyEquationEquals span -> ParserStepError (ExpectedTypeFamilyEquationEquals span);
            ExpectedConstructorForallDot span -> ParserStepError (ExpectedConstructorForallDot span);
            ExpectedExpressionCloseParen span -> ParserStepError (ExpectedExpressionCloseParen span)
          }
        }) : Parser ParserValue);

  def parserReturnAtEndOr : ParserValue -> Parser ParserValue -> Parser ParserValue =
    λ(doneValue : ParserValue) λ(nextParser : Parser ParserValue)
      (Parser
        (λ(state : ParserState) case parserStateAtEnd state of {
          ParserAtEnd -> ParserStepOk state doneValue;
          ParserNotAtEnd -> runParser nextParser state;
          ParserEndUnknown -> ParserStepError (ExpectedCompleteModule basicUnexpectedSpan)
        }) : Parser ParserValue);

  def parserCurrentTokenStartOr : String -> Parser ParserValue =
    λ(fallbackStart : String)
      (Parser
        (λ(state : ParserState) case state of {
          ParserState stream -> case stream of {
            SourceInputNil -> ParserStepOk state (ValueModuleKey fallbackStart);
            SourceInputCons token _ -> ParserStepOk state (ValueModuleKey (tokenStart token))
          }
        }) : Parser ParserValue);

  def captureSpan : Parser ParserValue -> Parser ParserValue =
    λ(parser : Parser ParserValue) parser;

  def diagnosticLabel : Parser ParserValue -> Parser ParserValue =
    λ(parser : Parser ParserValue) parserMap (λ(value : ParserValue) value) parser;

  def labelExpected : ParserExpectation -> Parser ParserValue -> Parser ParserValue =
    λ(expectation : ParserExpectation) λ(parser : Parser ParserValue)
      (Parser
        (λ(state : ParserState) case runParser parser state of {
          ParserStepOk nextState value -> ParserStepOk nextState value;
          ParserStepError diagnostic -> case diagnostic of {
            UnexpectedSourceText span -> ParserStepError (parserDiagnosticForExpectation expectation span);
            ExpectedCompleteModule span -> ParserStepError (ExpectedCompleteModule span);
            ExpectedEquals span -> ParserStepError (ExpectedEquals span);
            ExpectedImportSemicolon span -> ParserStepError (ExpectedImportSemicolon span);
            ExpectedImportAlias span -> ParserStepError (ExpectedImportAlias span);
            ExpectedImportExposingSeparator span -> ParserStepError (ExpectedImportExposingSeparator span);
            ExpectedDefSemicolon span -> ParserStepError (ExpectedDefSemicolon span);
            ExpectedLetIn span -> ParserStepError (ExpectedLetIn span);
            ExpectedLetAnnotationType span -> ParserStepError (ExpectedLetAnnotationType span);
            ExpectedConstructorColon span -> ParserStepError (ExpectedConstructorColon span);
            ExpectedCaseBranchArrow span -> ParserStepError (ExpectedCaseBranchArrow span);
            ExpectedInstanceMethodEquals span -> ParserStepError (ExpectedInstanceMethodEquals span);
            ExpectedFunctionalDependencyArrow span -> ParserStepError (ExpectedFunctionalDependencyArrow span);
            ExpectedTypeFamilyEquationEquals span -> ParserStepError (ExpectedTypeFamilyEquationEquals span);
            ExpectedConstructorForallDot span -> ParserStepError (ExpectedConstructorForallDot span);
            ExpectedExpressionCloseParen span -> ParserStepError (ExpectedExpressionCloseParen span)
          }
        }) : Parser ParserValue);

  def expectToken : TokenKind -> String -> Parser ParserValue =
    λ(kind : TokenKind) λ(fallbackSpan : String)
      (Parser
        (λ(state : ParserState) case state of {
          ParserState stream -> case stream of {
            SourceInputNil -> ParserStepError (UnexpectedSourceText fallbackSpan);
            SourceInputCons token rest -> case tokenMatches kind token of {
              TokenMatched -> ParserStepOk (ParserState rest) (ValueToken token);
              TokenMismatch -> ParserStepError (UnexpectedSourceText fallbackSpan)
            }
          }
        }) : Parser ParserValue);

  def expectIdentifierToken : String -> Parser ParserValue =
    λ(fallbackSpan : String)
      (Parser
        (λ(state : ParserState) case state of {
          ParserState stream -> case stream of {
            SourceInputNil -> ParserStepError (UnexpectedSourceText fallbackSpan);
            SourceInputCons token rest -> case stringIndexOf (tokenText token) "identifier:" of {
              None -> ParserStepError (UnexpectedSourceText fallbackSpan);
              Some _ -> ParserStepOk (ParserState rest) (ValueToken token)
            }
          }
        }) : Parser ParserValue);

  def expectTokenPrefix : String -> String -> Parser ParserValue =
    λ(prefix : String) λ(fallbackSpan : String)
      (Parser
        (λ(state : ParserState) case state of {
          ParserState stream -> case stream of {
            SourceInputNil -> ParserStepError (UnexpectedSourceText fallbackSpan);
            SourceInputCons token rest -> case stringIndexOf (tokenText token) prefix of {
              None -> ParserStepError (UnexpectedSourceText fallbackSpan);
              Some _ -> ParserStepOk (ParserState rest) (ValueToken token)
            }
          }
        }) : Parser ParserValue);

  def parserStateAtEnd : ParserState -> ParserEnd =
    λ(state : ParserState) case state of {
      ParserState stream -> case stream of {
        SourceInputNil -> ParserAtEnd;
        SourceInputCons _ _ -> ParserNotAtEnd
      }
    };
}
