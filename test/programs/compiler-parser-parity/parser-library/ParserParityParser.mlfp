        (parserBind (expectText ";")
          (appendRecursiveConstructorDataRowAndFinish sourceFile dataStart dataNameToken parameterValue constructorRowsValue constructorToken typeValue));

  def appendRecursiveConstructorDataRowAndContinue : String -> String -> ParserValue -> ParserValue -> ParserValue -> ParserValue -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(dataStart : String) λ(dataNameToken : ParserValue) λ(parameterValue : ParserValue) λ(constructorRowsValue : ParserValue) λ(constructorToken : ParserValue) λ(typeValue : ParserValue) λ(separatorToken : ParserValue)
