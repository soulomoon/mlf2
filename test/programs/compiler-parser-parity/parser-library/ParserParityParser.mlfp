    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(rowsValue : ParserValue)
      parseBoundedImportRowsNext sourceFile (parseImportedBodyAfterImport sourceFile moduleStart moduleName exportRows) rowsValue;

  def parseImportedBodyAfterImport : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(importRowsValue : ParserValue) case importRowsValue of {
      ValueProjectionRows _ ->
        parseModuleBodyRowsFirstAfterPrefix sourceFile moduleStart moduleName exportRows importRowsValue;
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueToken _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

  def parseImportProjectionRows : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parserBind (expectText "import")
        (parseImportProjectionModuleName sourceFile);

  def parseImportProjectionModuleName : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_importToken : ParserValue)
      parserBind expectAnyIdentifier
        (parseImportProjectionExposingKeyword sourceFile);

  def parseImportProjectionExposingKeyword : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleNameToken : ParserValue)
      parserBind (expectText "exposing")
        (parseImportProjectionOpen sourceFile moduleNameToken);

  def parseImportProjectionOpen : String -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleNameToken : ParserValue) λ(exposingToken : ParserValue)
      parserBind (expectText "(")
        (parseImportProjectionList sourceFile moduleNameToken exposingToken);

  def parseImportProjectionList : String -> ParserValue -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleNameToken : ParserValue) λ(exposingToken : ParserValue) λ(_openImport : ParserValue)
      parserBind (parseImportProjectionItem sourceFile ValueUnit)
        (prependImportModuleRows sourceFile moduleNameToken exposingToken);

  def prependImportModuleRows : String -> ParserValue -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleNameToken : ParserValue) λ(exposingToken : ParserValue) λ(itemRows : ParserValue) case moduleNameToken of {
      ValueToken _ -> case itemRows of {
        ValueProjectionRows rows ->
          parseBoundedDelimitedProjectionRowsMoreOrDone8 sourceFile ProjectionImportRows ProjectionRowsImportCloseOrSeparator ProjectionRowsImportFinalClose
            (ValueProjectionRows
              (appendLine (importModuleRows sourceFile (moduleNameFromValue moduleNameToken) (spanFromTokenStartToTokenStart moduleNameToken exposingToken)) rows));
        ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
        ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
        ValueToken _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
        ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
      };
      ValueProjectionRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

  def parseImportProjectionCloseOrSeparator : ParserValue -> Parser ParserValue =
    λ(itemRows : ParserValue)
      parserChoice
        (parseImportProjectionFinalClose itemRows)
        (parserFailExpectedAtCurrent ParserExpectImportExposingSeparator);

  def parseImportProjectionSemicolon : ParserValue -> ParserValue -> Parser ParserValue =
    λ(itemsRows : ParserValue) λ(_closeImport : ParserValue)
      parserBind expectImportSemicolonAtCurrent
        (λ(_semicolon : ParserValue) parserPure itemsRows);

  def parseImportProjectionFinalClose : ParserValue -> Parser ParserValue =
    λ(itemsRows : ParserValue)
      parserBind (expectText ")") (parseImportProjectionSemicolon itemsRows);

  def parseImportProjectionItem : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parserBind expectAnyIdentifier
        (parseProjectionImportItemTail sourceFile);

  def parseProjectionImportItemTail : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue)
      parserChoice
        (parserBind (parseTypeWithConstructorsMarker ValueUnit) (finishConstructedTypeImportItem sourceFile nameToken))
        (finishPlainProjectionImportItem sourceFile nameToken);

  def finishConstructedTypeImportItem : String -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue) λ(markerClose : ParserValue)
      projectionLineFromSpan sourceFile
        (stringAppend (stringAppend "import exposing type-with-constructors " (identifierNameFromValue nameToken)) " span=")
        (spanFromTokenBounds nameToken markerClose);

  def finishPlainProjectionImportItem : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue) case nameToken of {
      ValueToken token ->
        projectionLineFromSpan sourceFile
          (stringAppend (stringAppend (projectionImportKindPrefix (identifierNameFromValue nameToken)) (identifierNameFromValue nameToken)) " span=")
          (tokenSpan token);
      ValueProjectionRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

  def parseImportedMainDefinition : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(importRowsValue : ParserValue) case importRowsValue of {
      ValueProjectionRows importRows ->
        parserChoice
          (parserBind (parseImportedBoolMainRows sourceFile ValueUnit)
            (finishImportedBodyRows sourceFile moduleStart moduleName exportRows importRows))
          (parserChoice
            (parserBind (parseImportedNatMainRows sourceFile ValueUnit)
              (finishImportedBodyRows sourceFile moduleStart moduleName exportRows importRows))
            (parserChoice
              (parserBind (parseTextLiteralDefinitionRows sourceFile ValueUnit)
                (finishImportedBodyRows sourceFile moduleStart moduleName exportRows importRows))
              (parserChoice
                (parserBind (parseImportedIntReferenceMainRows sourceFile ValueUnit)
                  (finishImportedBodyRows sourceFile moduleStart moduleName exportRows importRows))
                (parserBind (parseImportedGenericBoolMainRows sourceFile ValueUnit)
                  (finishImportedBodyRows sourceFile moduleStart moduleName exportRows importRows)))));
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueToken _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

