    λ(sourceFile : String) λ(remainingImports : ParserValue -> Parser ParserValue) λ(existingRows : ParserValue)
      parserBind (parseImportProjectionRows sourceFile ValueUnit)
        (appendBoundedImportRowsAndContinue remainingImports existingRows);

