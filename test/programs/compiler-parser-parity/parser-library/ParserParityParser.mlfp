  def parseProjectionExportList : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parseBoundedDelimitedProjectionRows sourceFile ProjectionExportRows ProjectionRowsReturn ProjectionRowsReturn ValueUnit;

  def parseProjectionExportItem : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parserBind expectAnyIdentifier
        (parseProjectionExportItemTail sourceFile);

  def parseTypeWithConstructorsMarker : ParserValue -> Parser ParserValue =
    λ(_start : ParserValue)
      parserBind (expectText "(")
        parseTypeWithConstructorsMarkerFirstDot;

  def parseTypeWithConstructorsMarkerFirstDot : ParserValue -> Parser ParserValue =
    λ(_openConstructors : ParserValue)
      parserBind (expectText ".")
        parseTypeWithConstructorsMarkerSecondDot;

  def parseTypeWithConstructorsMarkerSecondDot : ParserValue -> Parser ParserValue =
    λ(_firstDot : ParserValue)
      parserBind (expectText ".")
        parseTypeWithConstructorsMarkerClose;

  def parseTypeWithConstructorsMarkerClose : ParserValue -> Parser ParserValue =
    λ(_secondDot : ParserValue)
      expectText ")";

  def parseProjectionExportItemTail : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue)
      parserChoice
        (parserBind (parseTypeWithConstructorsMarker ValueUnit) (finishConstructedTypeExportItem sourceFile nameToken))
        (finishPlainProjectionExportItem sourceFile nameToken);

  def finishConstructedTypeExportItem : String -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue) λ(markerClose : ParserValue)
      projectionLineFromSpan sourceFile
        (stringAppend (stringAppend "export type-with-constructors " (identifierNameFromValue nameToken)) " span=")
        (spanFromTokenBounds nameToken markerClose);

  def finishPlainProjectionExportItem : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(nameToken : ParserValue) case nameToken of {
      ValueToken token ->
        projectionLineFromSpan sourceFile
          (stringAppend (stringAppend (projectionExportKindPrefix (identifierNameFromValue nameToken)) (identifierNameFromValue nameToken)) " span=")
          (tokenSpan token);
      ValueProjectionRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

  def parseModuleBodyRowsFirst : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(_start : ParserValue)
      parserBind (parseModuleBodyDeclarationRows sourceFile ValueUnit)
        (parseModuleBodyRowsMoreOrClose sourceFile moduleStart moduleName exportRows);

  def parseModuleBodyRowsFirstAfterPrefix : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(existingRows : ParserValue)
      parserBind (parseModuleBodyDeclarationRows sourceFile ValueUnit)
        (appendModuleBodyDeclarationRowsAndContinue (parseModuleBodyRowsMoreOrClose sourceFile moduleStart moduleName exportRows) existingRows);

  def parseModuleBodyRowsMoreOrClose : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(rowsValue : ParserValue)
      parserChoice
        (parserBind (parseModuleBodyDeclarationRows sourceFile ValueUnit)
          (appendModuleBodyDeclarationRowsAndContinue (parseModuleBodyRowsMoreOrClose sourceFile moduleStart moduleName exportRows) rowsValue))
        (finishModuleBodyRows sourceFile moduleStart moduleName exportRows rowsValue);

  def appendModuleBodyDeclarationRowsAndContinue : (ParserValue -> Parser ParserValue) -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(continueRows : ParserValue -> Parser ParserValue) λ(existingRows : ParserValue) λ(nextRows : ParserValue)
      parserBind (appendProjectionValues existingRows nextRows)
        continueRows;

  def parseModuleBodyDeclarationRows : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parserChoice (parseCharLiteralDefinitionRows sourceFile ValueUnit)
        (parserChoice (parseSourceDefinitionRowsWithCurrentDefSemicolon sourceFile ValueUnit)
          (parserChoice (parseEqClassDeclaration sourceFile ValueUnit)
            (parserChoice (parseEqNatInstanceDeclarationRows sourceFile ValueUnit)
              (parseModuleBodyDataDeclarationRows sourceFile ValueUnit))));

  def parseModuleBodyDataDeclarationRows : String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(_start : ParserValue)
      parserChoice (parseTwoConstructorDerivedDataRows sourceFile ValueUnit)
        (parseRecursiveConstructorDataRows sourceFile ValueUnit);

  def finishModuleBodyRows : String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(bodyRowsValue : ParserValue) case bodyRowsValue of {
      ValueProjectionRows bodyRows ->
        parserBind (expectText "}")
          (finishModuleRowsWithClose sourceFile moduleStart moduleName exportRows bodyRows);
      ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueToken _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
      ValueUnit -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
    };

  def finishModuleRowsWithClose : String -> String -> String -> String -> String -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(moduleStart : String) λ(moduleName : String) λ(exportRows : String) λ(bodyRows : String) λ(closeModule : ParserValue)
      parserBind (parserCurrentTokenStartOr (lineStartAfterColumnOne (tokenStartCoordinate closeModule)))
        (λ(moduleEnd : ParserValue)
          projectionText
            (moduleRows
              sourceFile
              moduleName
              (spanFromStartToStringCoordinate moduleStart (moduleEndCoordinateAfterClose closeModule moduleEnd))
              (appendLine exportRows bodyRows)));

