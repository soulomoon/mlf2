  def finishRecursiveConstructorDataRows : String -> String -> ParserValue -> ParserValue -> ParserValue -> ParserValue -> Parser ParserValue =
    λ(sourceFile : String) λ(dataStart : String) λ(dataNameToken : ParserValue) λ(parameterValue : ParserValue) λ(semicolonToken : ParserValue) λ(constructorRowsValue : ParserValue)
      parserBind (parserCurrentTokenStartOr (tokenEndCoordinate semicolonToken))
        (λ(dataEnd : ParserValue) case parameterValue of {
          ValueToken parameterToken ->
            projectionText
              (appendLine
                (dataParamRows sourceFile (identifierNameFromValue dataNameToken) (identifierNameFromTokenText (tokenText parameterToken)) (spanFromStartToCoordinate dataStart dataEnd))
                (constructorRowsFromValue constructorRowsValue));
          ValueUnit ->
            projectionText
              (dataRowsWithConstructorRows
                sourceFile
                dataNameToken
                (spanFromStartToCoordinate dataStart dataEnd)
                constructorRowsValue);
          ValueProjectionRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
          ValueConstructorRows _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan);
          ValueModuleKey _ -> parserFail (ExpectedCompleteModule basicUnexpectedSpan)
        });

