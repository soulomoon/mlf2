module Main export (main) {
  import Prelude exposing (Unit(..), IO, putStrLn);
  import ParserParityFixture exposing (coreSourceFile, coreSourceText, mainSourceFile, mainSourceText);
  import ParserParityParser exposing (renderParserParityPackageProjectionFromSourceTexts);

  def main : IO Unit =
    putStrLn (renderParserParityPackageProjectionFromSourceTexts coreSourceFile coreSourceText mainSourceFile mainSourceText);
}
