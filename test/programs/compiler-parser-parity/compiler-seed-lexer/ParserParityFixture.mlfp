module ParserParityFixture export (seedLexerSourceFile, seedLexerSourceText) {
  def seedLexerSourceFile : String =
    "test/conformance/mlfp/parser-parity/compiler-seed-lexer/src/SeedLexer.mlfp";

  def seedLexerSourceText : String =
    "module SeedLexer export (LexerResult(..), LexerEvidence(..), lexSeedInput, positiveLexerResult, negativeLexerResult, lexerEvidence, renderLexerEvidence) {\n  import SeedSource exposing (SourcePosition(..), SourceSpan(..), SeedIdentifier(..), SeedBoolLiteral(..), SeedInput(..), SeedInputSymbol(..), spanStart, spanEnd, positiveSeedInput, negativeSeedInput);\n  import SeedToken exposing (SeedToken(..), SeedTokenStream(..));\n  import SeedDiagnostic exposing (LexerDiagnosticKind(..), LexerDiagnostic(..));\n\n  data LexerResult =\n      LexerOk : SeedTokenStream -> LexerResult\n    | LexerError : LexerDiagnostic -> LexerResult;\n\n  data LexerEvidence =\n      LexerEvidence : LexerResult -> LexerResult -> LexerEvidence;\n\n  data PositiveLexerEvidence =\n      PositiveLexerAccepted : PositiveLexerEvidence\n    | PositiveLexerRejected : PositiveLexerEvidence;\n\n  data NegativeLexerEvidence =\n      NegativeLexerAccepted : NegativeLexerEvidence\n    | NegativeLexerRejected : NegativeLexerEvidence;\n\n  def lexSeedInput : SeedInput -> LexerResult =\n    λ(input : SeedInput) case input of {\n      SeedInputNil -> LexerError (LexerDiagnostic SpanDefKeyword UnknownInputSymbol);\n      SeedInputCons symbol rest -> case symbol of {\n        InputDef span -> lexAfterDef span rest;\n        InputIdentifier span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputEquals span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputBoolLiteral span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputUnknown span -> LexerError (LexerDiagnostic span UnknownInputSymbol)\n      }\n    };\n\n  def lexAfterDef : SourceSpan -> SeedInput -> LexerResult =\n    λ(defSpan : SourceSpan) λ(input : SeedInput) case input of {\n      SeedInputNil -> LexerError (LexerDiagnostic defSpan UnknownInputSymbol);\n      SeedInputCons symbol rest -> case symbol of {\n        InputIdentifier identSpan identifier -> lexAfterIdentifier defSpan identSpan identifier rest;\n        InputDef span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputEquals span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputBoolLiteral span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputUnknown span -> LexerError (LexerDiagnostic span UnknownInputSymbol)\n      }\n    };\n\n  def lexAfterIdentifier : SourceSpan -> SourceSpan -> SeedIdentifier -> SeedInput -> LexerResult =\n    λ(defSpan : SourceSpan) λ(identSpan : SourceSpan) λ(identifier : SeedIdentifier) λ(input : SeedInput) case input of {\n      SeedInputNil -> LexerError (LexerDiagnostic identSpan UnknownInputSymbol);\n      SeedInputCons symbol rest -> case symbol of {\n        InputEquals equalsSpan -> lexAfterEquals defSpan identSpan identifier equalsSpan rest;\n        InputDef span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputIdentifier span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputBoolLiteral span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputUnknown span -> LexerError (LexerDiagnostic span UnknownInputSymbol)\n      }\n    };\n\n  def lexAfterEquals : SourceSpan -> SourceSpan -> SeedIdentifier -> SourceSpan -> SeedInput -> LexerResult =\n    λ(defSpan : SourceSpan) λ(identSpan : SourceSpan) λ(identifier : SeedIdentifier) λ(equalsSpan : SourceSpan) λ(input : SeedInput) case input of {\n      SeedInputNil -> LexerError (LexerDiagnostic equalsSpan UnknownInputSymbol);\n      SeedInputCons symbol rest -> case symbol of {\n        InputBoolLiteral literalSpan literal -> lexAfterLiteral defSpan identSpan identifier equalsSpan literalSpan literal rest;\n        InputDef span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputIdentifier span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputEquals span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputUnknown span -> LexerError (LexerDiagnostic span UnknownInputSymbol)\n      }\n    };\n\n  def lexAfterLiteral : SourceSpan -> SourceSpan -> SeedIdentifier -> SourceSpan -> SourceSpan -> SeedBoolLiteral -> SeedInput -> LexerResult =\n    λ(defSpan : SourceSpan) λ(identSpan : SourceSpan) λ(identifier : SeedIdentifier) λ(equalsSpan : SourceSpan) λ(literalSpan : SourceSpan) λ(literal : SeedBoolLiteral) λ(input : SeedInput) case input of {\n      SeedInputNil ->\n        LexerOk\n          (SeedTokenCons (TokenDef defSpan)\n            (SeedTokenCons (TokenIdentifier identSpan identifier)\n              (SeedTokenCons (TokenEquals equalsSpan)\n                (SeedTokenCons (TokenBoolLiteral literalSpan literal)\n                  SeedTokenNil))));\n      SeedInputCons symbol _ -> case symbol of {\n        InputDef span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputIdentifier span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputEquals span -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputBoolLiteral span _ -> LexerError (LexerDiagnostic span UnknownInputSymbol);\n        InputUnknown span -> LexerError (LexerDiagnostic span UnknownInputSymbol)\n      }\n    };\n\n  def positiveLexerResult : LexerResult =\n    lexSeedInput positiveSeedInput;\n\n  def negativeLexerResult : LexerResult =\n    lexSeedInput negativeSeedInput;\n\n  def lexerEvidence : LexerEvidence =\n    LexerEvidence positiveLexerResult negativeLexerResult;\n\n  def renderLexerEvidence : LexerEvidence -> String =\n    λ(evidence : LexerEvidence) case evidence of {\n      LexerEvidence positive negative -> case classifyPositiveLexerEvidence positive of {\n        PositiveLexerAccepted -> case classifyNegativeLexerEvidence negative of {\n          NegativeLexerAccepted -> \"lexer-positive:def-main-equals-true;lexer-negative:unknown@span-unknown-symbol\";\n          NegativeLexerRejected -> \"lexer-evidence:mismatch\"\n        };\n        PositiveLexerRejected -> \"lexer-evidence:mismatch\"\n      }\n    };\n\n  def classifyPositiveLexerEvidence : LexerResult -> PositiveLexerEvidence =\n    λ(result : LexerResult) case result of {\n      LexerOk tokens -> classifyPositiveTokenDef tokens;\n      LexerError _ -> PositiveLexerRejected\n    };\n\n  def classifyPositiveTokenDef : SeedTokenStream -> PositiveLexerEvidence =\n    λ(tokens : SeedTokenStream) case tokens of {\n      SeedTokenNil -> PositiveLexerRejected;\n      SeedTokenCons token rest -> case token of {\n        TokenDef span -> case span of {\n          SpanDefKeyword -> classifyPositiveTokenIdentifier rest;\n          SpanIdentifierMain -> PositiveLexerRejected;\n          SpanEquals -> PositiveLexerRejected;\n          SpanBoolTrue -> PositiveLexerRejected;\n          SpanUnknownSymbol -> PositiveLexerRejected\n        };\n        TokenIdentifier _ _ -> PositiveLexerRejected;\n        TokenEquals _ -> PositiveLexerRejected;\n        TokenBoolLiteral _ _ -> PositiveLexerRejected\n      }\n    };\n\n  def classifyPositiveTokenIdentifier : SeedTokenStream -> PositiveLexerEvidence =\n    λ(tokens : SeedTokenStream) case tokens of {\n      SeedTokenNil -> PositiveLexerRejected;\n      SeedTokenCons token rest -> case token of {\n        TokenIdentifier span identifier -> case span of {\n          SpanDefKeyword -> PositiveLexerRejected;\n          SpanIdentifierMain -> case identifier of {\n            IdentifierMain -> classifyPositiveTokenEquals rest\n          };\n          SpanEquals -> PositiveLexerRejected;\n          SpanBoolTrue -> PositiveLexerRejected;\n          SpanUnknownSymbol -> PositiveLexerRejected\n        };\n        TokenDef _ -> PositiveLexerRejected;\n        TokenEquals _ -> PositiveLexerRejected;\n        TokenBoolLiteral _ _ -> PositiveLexerRejected\n      }\n    };\n\n  def classifyPositiveTokenEquals : SeedTokenStream -> PositiveLexerEvidence =\n    λ(tokens : SeedTokenStream) case tokens of {\n      SeedTokenNil -> PositiveLexerRejected;\n      SeedTokenCons token rest -> case token of {\n        TokenEquals span -> case span of {\n          SpanDefKeyword -> PositiveLexerRejected;\n          SpanIdentifierMain -> PositiveLexerRejected;\n          SpanEquals -> classifyPositiveTokenLiteral rest;\n          SpanBoolTrue -> PositiveLexerRejected;\n          SpanUnknownSymbol -> PositiveLexerRejected\n        };\n        TokenDef _ -> PositiveLexerRejected;\n        TokenIdentifier _ _ -> PositiveLexerRejected;\n        TokenBoolLiteral _ _ -> PositiveLexerRejected\n      }\n    };\n\n  def classifyPositiveTokenLiteral : SeedTokenStream -> PositiveLexerEvidence =\n    λ(tokens : SeedTokenStream) case tokens of {\n      SeedTokenNil -> PositiveLexerRejected;\n      SeedTokenCons token rest -> case token of {\n        TokenBoolLiteral span literal -> case span of {\n          SpanDefKeyword -> PositiveLexerRejected;\n          SpanIdentifierMain -> PositiveLexerRejected;\n          SpanEquals -> PositiveLexerRejected;\n          SpanBoolTrue -> case literal of {\n            BoolLiteralTrue -> case rest of {\n              SeedTokenNil -> PositiveLexerAccepted;\n              SeedTokenCons _ _ -> PositiveLexerRejected\n            }\n          };\n          SpanUnknownSymbol -> PositiveLexerRejected\n        };\n        TokenDef _ -> PositiveLexerRejected;\n        TokenIdentifier _ _ -> PositiveLexerRejected;\n        TokenEquals _ -> PositiveLexerRejected\n      }\n    };\n\n  def classifyNegativeLexerEvidence : LexerResult -> NegativeLexerEvidence =\n    λ(result : LexerResult) case result of {\n      LexerOk _ -> NegativeLexerRejected;\n      LexerError diagnostic -> case diagnostic of {\n        LexerDiagnostic span kind -> case kind of {\n          UnknownInputSymbol -> case span of {\n            SpanDefKeyword -> NegativeLexerRejected;\n            SpanIdentifierMain -> NegativeLexerRejected;\n            SpanEquals -> NegativeLexerRejected;\n            SpanBoolTrue -> NegativeLexerRejected;\n            SpanUnknownSymbol -> classifyUnknownSpanPositions span\n          }\n        }\n      }\n    };\n\n  def classifyUnknownSpanPositions : SourceSpan -> NegativeLexerEvidence =\n    λ(span : SourceSpan) case spanStart span of {\n      Line1Column1 -> NegativeLexerRejected;\n      Line1Column4 -> NegativeLexerRejected;\n      Line1Column5 -> case spanEnd span of {\n        Line1Column1 -> NegativeLexerRejected;\n        Line1Column4 -> NegativeLexerRejected;\n        Line1Column5 -> NegativeLexerRejected;\n        Line1Column6 -> NegativeLexerAccepted;\n        Line1Column9 -> NegativeLexerRejected;\n        Line1Column10 -> NegativeLexerRejected;\n        Line1Column11 -> NegativeLexerRejected;\n        Line1Column12 -> NegativeLexerRejected;\n        Line1Column16 -> NegativeLexerRejected\n      };\n      Line1Column6 -> NegativeLexerRejected;\n      Line1Column9 -> NegativeLexerRejected;\n      Line1Column10 -> NegativeLexerRejected;\n      Line1Column11 -> NegativeLexerRejected;\n      Line1Column12 -> NegativeLexerRejected;\n      Line1Column16 -> NegativeLexerRejected\n    };\n}\n";
}
